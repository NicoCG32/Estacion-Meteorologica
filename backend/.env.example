# Los scripts npm cargan backend/.env si existe (Node 24).
# Copia este archivo a .env y descomenta solo lo que necesites cambiar.
# Las variables del proceso tienen prioridad sobre .env.

# Sin PORT: estacion/start = 3001; dev = 3002.
# PORT=3002

# Sin HOST: 0.0.0.0. Para pruebas solo en este PC, usa 127.0.0.1.
# El ESP32 necesita que el servidor escuche en la interfaz de red del PC.
# HOST=127.0.0.1

# Sin DATA_FILE: backend/data/mediciones.jsonl (historico compartido).
# Para pruebas usa otro archivo. Las rutas relativas parten de backend/ al
# ejecutar npm run; una ruta absoluta evita depender del directorio actual.
# DATA_FILE=data/mediciones-prueba.jsonl

# Sin LOG_LEVEL: info. Valores: silent, error, warn, info, debug.
# Los logs son JSON por linea y no incluyen el cuerpo de cada medicion.
# LOG_LEVEL=info
