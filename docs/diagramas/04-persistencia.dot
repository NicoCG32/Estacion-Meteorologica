digraph G { graph [rankdir=TB,bgcolor="#fafaf7",pad=".3",nodesep=".5",ranksep=".8",splines=polyline]; node [fontname="Arial",fontsize=11,shape=box,style="rounded,filled",margin=".22,.16",penwidth=1.5]; edge [fontname="Arial",fontsize=10,color="#66858a",arrowsize=.7,penwidth=1.4]; post [label="POST JSON\n4 claves requeridas\nvalores o null",fillcolor="#e0eeec",color="#2f847e"]; validate [label="Validación\ny detección de salto",fillcolor="#e6eef7",color="#5785a1"]; one [label="Registro JSONL\nid + timestamp\nvalores + sospecha",fillcolor="#e6eef7",color="#5785a1"]; disk [label="Archivo JSONL\n1 objeto / línea",shape=cylinder,fillcolor="#f4eedc",color="#a98750"]; ram [label="Ventana RAM\nhasta 1000\ntras escritura y cierre",fillcolor="#f4eedc",color="#a98750"]; exp [label="Exportación\nCSV / JSONL",fillcolor="#e0eeec",color="#2f847e"];dash [label="Dashboard\núltimas 60",fillcolor="#e0eeec",color="#2f847e"]; post -> validate -> one -> disk;disk -> ram; disk -> exp;ram -> dash;}
